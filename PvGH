-- ========== DETECT WORLD CHANGE ==========
function checkWorldChange()
    local world = getWorld()
    local player = getLocal()
    
    if world and player then
        if world.name ~= last_world then
            last_world = world.name
            
            -- Cek apakah world ini termasuk worldHarvest
            for _, w in pairs(worldHarvest) do
                local harvest_name, harvest_id = w:match("(.+)|(.+)")
                if harvest_name == world.name then
                    sendProviderNotif(world.name, harvest_id)
                    break
                end
            end
        end
    end
end

