-- check inv function
function inv(x)
    for _, item in pairs(getInventory()) do
	    if item.id == x then
		    return item.amount
		end
	end
	return 0
end

-- Take function
function takeItem() 
    for _, obj in pairs(getWorldObject()) do
        local xn = getLocal().pos.x//32
        local yn = getLocal().pos.y//32
        xtiles = {xn-3,xn-2,xn-1,xn,xn+1,xn+2}
        for _, tiles in pairs(xtiles) do
            if (obj.pos.x)//32 == tiles and ((obj.pos.y)//32 == yn or obj.pos.y//32 == yn-1) then            
                sendPacketRaw(false, {type=11,value=obj.oid,x=obj.pos.x,y=obj.pos.y})                                
            end
        end
    end
end

