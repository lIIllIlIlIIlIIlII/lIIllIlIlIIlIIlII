function inv(x)
    for _, item in pairs(GetInventory()) do
        if item.id == x then return item.amount end
    end
    return 0
end

local function Decolorize(parameter)
    parameter = parameter:gsub("`[`0-9A-Za-z%+!@#%$%%%^&%*%(%)%-'\":;,%?~\\|<>{}%[%]%.]?", "")
    return parameter
end

