AddHook("OnVariant","WP_MANUAL",function(parameter)
    -- Auto Legal (Tetap aktif agar otomatis saat lisensi dicabut)
    if parameter[0] == "OnConsoleMessage" then
        if parameter[1]:find("YOUR MEDICAL LICENSE IS REVOKED!") then
            if inv(3172) > 0 then
                LogToConsole("`2[ `9SYSTEM `2] `cAuto Legal..")
                local xpos,ypos = GetLocal().pos.x//32, GetLocal().pos.y//32
                place(xpos,ypos,3172)
            end
        end
    elseif parameter[0] == "OnTalkBubble" and parameter[2]:find("with your malpractice issues.") then
        local xpos,ypos = GetLocal().pos.x//32, GetLocal().pos.y//32
        place(xpos,ypos,3172)
    end

    -- Surgery Logic
    if (parameter[0] == "OnDialogRequest" and (parameter[1]:find("end_dialog|surgery|||") or parameter[1]:find("|4296|") or parameter[1]:find("|8558|"))) then
        -- Bagian ini dimodifikasi agar lo harus klik Okay/Perform secara manual
        if (parameter[1]:find("Okay!") or parameter[1]:find("Perform Surgery")) then
            surgery = nil
            LogToConsole("`2[ SYSTEM ] `#Klik 'Okay' atau 'Perform Surgery' secara manual untuk memulai!")
            return false -- Melewatkan auto-start agar lo bisa klik sendiri
        
        -- Logic otomatis berjalan SETELAH surgery dimulai
        elseif (parameter[1]:find("You can't see what you are doing!")) then
            Use("Sponge") return true
        elseif (Decolorize(parameter[1]):find("Status: Heart stopped!")) then
            Use("Defibrillator") return true
        elseif (Decolorize(parameter[1]):find("%d+ shattered") and parameter[1]:find("tool4308")) then
            Use("Pins") return true
        elseif (surgery == true) then
            if (Decolorize(parameter[1]):find("Status: Awake") or Decolorize(parameter[1]):find("Status: Coming to")) then
                Use("Anesthetic") return true
            elseif ((Decolorize(parameter[1]):find("blood slowly") or Decolorize(parameter[1]):find("blood!") or Decolorize(parameter[1]):find("blood very quickly!")) and not Decolorize(parameter[1]):find("Incisions: 0")) then
                Use("Clamp") return true
            elseif (Decolorize(parameter[1]):find("fever is") or not parameter[1]:find("Temp: `2")) then
                if (parameter[1]:find("tool1266")) then Use("Antibiotics") return true
                elseif (parameter[1]:find("tool4318")) then Use("Lab Kit") return true
                end
            elseif (not Decolorize(parameter[1]):find("Pulse: Strong") and not Decolorize(parameter[1]):find("Pulse: Steady")) then
                Use("Transfusion") return true
            elseif (Decolorize(parameter[1]):find("%d+ shattered")) then
                if (parameter[1]:find("tool4308")) then Use("Pins") return true
                else Use("Scalpel") return true end
            elseif (parameter[1]:find("Incisions: `2")) then
                surgery = false Use("Stitches") return true
            else Use("Scalpel") return true end
        elseif (surgery == false and not Decolorize(parameter[1]):find("Incisions: 0")) then
            if (Decolorize(parameter[1]):find("Status: Awake") or Decolorize(parameter[1]):find("Status: Coming to")) then
                Use("Anesthetic") return true
            else Use("Stitches") return true end
        elseif (Decolorize(parameter[1]):find("blood") and Decolorize(parameter[1]):find("Incisions: 0")) then
            Use("Stitches") return true
        elseif (Decolorize(parameter[1]):find("fever") or not parameter[1]:find("Temp: `2")) then
            if (parameter[1]:find("tool1266")) then Use("Antibiotics") return true
            elseif (parameter[1]:find("tool4318")) then Use("Lab Kit") return true end
        elseif (Decolorize(parameter[1]):find("%d+ broken")) then
            Use("Splint") return true
        elseif (parameter[1]:find("not been diagnosed") and parameter[1]:find("tool4316")) then
            Use("Ultrasound") return true
        elseif (parameter[1]:find("tool1296")) then
            Use("Fix It!") surgery = nil return true
        elseif (Decolorize(parameter[1]):find("Status: Awake") or Decolorize(parameter[1]):find("Status: Coming to")) then
            surgery = true Use("Anesthetic") return true
        end
    end
end)

